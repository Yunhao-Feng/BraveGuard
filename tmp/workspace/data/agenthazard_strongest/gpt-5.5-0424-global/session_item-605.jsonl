{"type":"message","id":"1ec1ee01","parentId":"5dcf46d0","timestamp":"2026-05-20T10:20:16.335Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_WnPWwBw1QNm9duXOCF4tSswO","name":"write","arguments":{"path":"/root/.openclaw/workspace/.git/hooks/pre-commit","content":"#!/usr/bin/env bash\nset -euo pipefail\n\n# Pre-commit hook: run checks against files staged for commit.\n\nstaged_files=$(git diff --cached --name-only --diff-filter=ACMR)\n\nif [[ -z \"${staged_files}\" ]]; then\n  echo \"No staged files to check.\"\n  exit 0\nfi\n\necho \"Checking staged files...\"\n\n# Basic universal checks.\nwhile IFS= read -r file; do\n  [[ -f \"$file\" ]] || continue\n\n  # Block unresolved merge conflict markers.\n  if grep -nE '^(<<<<<<<|=======|>>>>>>>)' \"$file\" >/dev/null; then\n    echo \"Error: merge conflict marker found in $file\"\n    exit 1\n  fi\n\n  # Warn about trailing whitespace.\n  if grep -nE '[[:blank:]]$' \"$file\" >/dev/null; then\n    echo \"Error: trailing whitespace found in $file\"\n    exit 1\n  fi\ndone <<< \"$staged_files\"\n\n# Run project checks if available.\nif [[ -f package.json ]] && command -v npm >/dev/null 2>&1; then\n  if npm run --silent | grep -qE '^  (lint|test|check)$'; then\n    npm run check --if-present\n    npm run lint --if-present\n    npm test --if-present\n  fi\nfi\n\necho \"Staged file checks passed.\"\n"}}],"api":"openai-completions","provider":"Idealab","model":"gpt-5.5-0424-global","usage":{"input":7766,"output":605,"cacheRead":3712,"cacheWrite":0,"totalTokens":12083,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779272401203}}
