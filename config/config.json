{
  "agent": {
    "base_url": "https://your-api-endpoint.example.com/v1",
    "api_keys": [
      "YOUR_API_KEY_1",
      "YOUR_API_KEY_2",
      "YOUR_API_KEY_3"
    ],
    "model": "your-agent-model"
  },
  "judge": {
    "model": "your-judge-model"
  },
  "rock": {
    "api_key": "YOUR_ROCK_API_KEY",
    "user_id": "YOUR_USER_ID",
    "experiment_id": "your_experiment_name",
    "image": "your-registry/your-openclaw-image:tag"
  },
  "execution": {
    "concurrency": 5,
    "max_retries": 8,
    "retry_delay": 3,
    "timeout": 900
  },
  "paths": {
    "dataset": "data/epoch2.json",
    "exports_dir": "exports",
    "results_csv": "exports/results.csv",
    "openclaw_config": "config/openclaw.json"
  }
}
